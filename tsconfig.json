{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "outDir": "lib",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/cordis": ["Y:/DSH/dsh-secure-mesh/node_modules/@deepseek-ai/cordis"],
      "@deepseek-ai/dsh-tools": ["Y:/DSH/dsh-secure-mesh/node_modules/@deepseek-ai/dsh-tools"],
      "@deepseek-ai/dsh-system-prompt": ["Y:/DSH/dsh-secure-mesh/node_modules/@deepseek-ai/dsh-system-prompt"],
      "@deepseek-ai/schemastery": ["Y:/DSH/dsh-secure-mesh/node_modules/@deepseek-ai/schemastery"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "lib", "tests"]
}